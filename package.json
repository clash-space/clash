{
  "name": "master-clash",
  "version": "0.1.0",
  "private": true,
  "description": "Where agents co-create, humans are welcome too.",
  "scripts": {
    "dev": "turbo run dev",
    "dev:log": "./scripts/dev-log.sh",
    "logs": "./scripts/logs.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @master-clash/local-api test:e2e && pnpm --filter @master-clash/web test:e2e && pnpm --filter @master-clash/desktop test:e2e",
    "test:e2e:qa-agent": "pnpm --filter @master-clash/desktop test:e2e:qa-agent",
    "test:e2e:agent-first-local-v1": "pnpm --filter @master-clash/desktop test:e2e:agent-first-local-v1",
    "test:e2e:short-drama-timeline": "pnpm --filter @master-clash/desktop test:e2e:short-drama-timeline",
    "test:e2e:agent-first-cas": "pnpm --filter @master-clash/desktop test:e2e:agent-first-cas",
    "test:skills": "node --test skills/skill-market.test.mjs skills/video-production-e2e.test.mjs",
    "test:agent:real-codex": "pnpm --filter @master-clash/desktop test:agent:real-codex",
    "test:startup": "pnpm --filter @master-clash/desktop test:startup",
    "test:startup:harness-update-gui": "pnpm --filter @master-clash/desktop test:startup:harness-update-gui",
    "test:startup:real-codex-cold": "pnpm --filter @master-clash/desktop test:startup:real-codex-cold",
    "test:startup:real-codex": "pnpm --filter @master-clash/desktop test:startup:real-codex",
    "test:startup:real-codex-resume": "pnpm --filter @master-clash/desktop test:startup:real-codex-resume",
    "assets:director:anny": "tsx scripts/generate-director-anny-assets.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "keywords": [
    "creative-platform",
    "agent-platform",
    "ai-video-editor",
    "agent-native",
    "ai-agents",
    "generative-ai",
    "video-production",
    "video-editor",
    "timeline",
    "mcp",
    "codex",
    "electron",
    "remotion",
    "self-hosted",
    "crdt",
    "cloudflare",
    "react"
  ],
  "author": "hrhrng <hrhrng@foxmail.com>",
  "license": "PolyForm-Shield-1.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "remotion": "4.0.370",
      "@remotion/*": "4.0.370",
      "@vitest/utils": "4.1.0",
      "@vitest/runner": "4.1.0",
      "@vitest/snapshot": "4.1.0",
      "@vitest/expect": "4.1.0",
      "@vitest/spy": "4.1.0",
      "@vitest/pretty-format": "4.1.0",
      "@vitest/mocker": "4.1.0",
      "vitest": "4.1.0",
      "@electron/get": "5.0.0"
    }
  },
  "dependencies": {
    "@cloudflare/containers": "^0.2.0",
    "better-auth": "^1.4.6",
    "better-auth-cloudflare": "^0.2.9",
    "zod": "^4"
  }
}
