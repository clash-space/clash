{
  "kind": "team.shot-notes",
  "schemaVersion": 1,
  "description": "Per-shot notes this team keeps on its own footage.",
  "schema": {
    "type": "object",
    "required": ["kind", "schemaVersion", "notes"],
    "additionalProperties": false,
    "properties": {
      "kind": { "const": "team.shot-notes" },
      "schemaVersion": { "const": 1 },
      "notes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["shot", "note"],
          "additionalProperties": false,
          "properties": {
            "shot": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 },
            "keep": { "type": "boolean" }
          }
        }
      }
    }
  }
}
