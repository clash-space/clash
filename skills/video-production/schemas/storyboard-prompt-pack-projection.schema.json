{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash storyboard prompt-pack projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "storyboardAssetId",
    "promptPack",
    "promptPackHash",
    "appliedAt",
    "casApply"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.storyboard.prompt-pack.projection" },
    "storyboardAssetId": { "type": "string" },
    "sourceActionPath": { "type": "string" },
    "promptPack": {
      "type": "object",
      "required": ["schemaVersion", "kind", "storyboardAssetId", "prompts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "clash.storyboard.prompt-pack" },
        "storyboardAssetId": { "type": "string" },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "panelId",
              "sceneId",
              "characterIds",
              "prompt",
              "outputAssetId",
              "outputPath"
            ],
            "properties": {
              "id": { "type": "string" },
              "panelId": { "type": "string" },
              "sceneId": { "type": "string" },
              "characterIds": { "type": "array", "items": { "type": "string" } },
              "prompt": { "type": "string" },
              "negativePrompt": { "type": "string" },
              "outputAssetId": { "type": "string" },
              "outputPath": { "type": "string" },
              "modelHint": { "type": "string" }
            }
          }
        }
      }
    },
    "promptPackHash": { "type": "string" },
    "appliedAt": { "type": "string" },
    "casApply": {
      "type": "object",
      "required": ["target", "mutation", "applyCommand", "filePath"],
      "properties": {
        "target": { "const": "storyboard-prompt-pack" },
        "mutation": { "const": "managed-projection" },
        "applyCommand": { "const": "clash production apply-storyboard-prompt-pack" },
        "filePath": { "type": "string" }
      }
    }
  }
}
