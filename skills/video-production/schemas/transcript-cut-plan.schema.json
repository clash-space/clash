{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash talking-head transcript cut plan projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "sourceAssetId",
    "strategy",
    "fps",
    "cuts",
    "sourceToOutputMap",
    "captionTrack"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.talking-head.transcript-cut-plan.projection" },
    "sourceAssetId": { "type": "string" },
    "strategy": { "enum": ["subtitle-only", "conservative", "balanced", "aggressive"] },
    "fps": { "type": "number" },
    "asr": {
      "type": "object",
      "properties": {
        "kind": { "const": "asr-transcript" },
        "sourcePath": { "type": "string" },
        "sourceHash": { "type": "string" },
        "backendId": { "type": "string" },
        "modelId": { "type": "string" },
        "language": { "type": "string" },
        "durationFrames": { "type": "number" },
        "wordCount": { "type": "number" },
        "averageConfidence": { "type": "number" }
      }
    },
    "disfluencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "id": { "type": "string" },
          "wordId": { "type": "string" },
          "startFrame": { "type": "number" },
          "endFrame": { "type": "number" },
          "text": { "type": "string" },
          "type": { "enum": ["filler", "silence", "tone-particle", "repeat"] },
          "requiresReview": { "type": "boolean" },
          "confidence": { "type": "number" },
          "detectionSource": { "type": "string" }
        }
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceStartFrame",
          "sourceEndFrame",
          "outputStartFrame",
          "outputEndFrame",
          "action"
        ],
        "properties": {
          "id": { "type": "string" },
          "sourceStartFrame": { "type": "number" },
          "sourceEndFrame": { "type": "number" },
          "outputStartFrame": { "type": "number" },
          "outputEndFrame": { "type": "number" },
          "action": { "enum": ["keep", "delete", "review"] },
          "reason": { "enum": ["silence", "filler", "tone-particle", "repeat", "false-start", "manual"] },
          "requiresReview": { "type": "boolean" },
          "confidence": { "type": "number" },
          "detectionSource": { "type": "string" }
        }
      }
    },
    "sourceToOutputMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceStartFrame", "sourceEndFrame", "outputStartFrame", "outputEndFrame"],
        "properties": {
          "sourceStartFrame": { "type": "number" },
          "sourceEndFrame": { "type": "number" },
          "outputStartFrame": { "type": "number" },
          "outputEndFrame": { "type": "number" }
        }
      }
    },
    "captionTrack": {
      "type": "object",
      "required": ["id", "type", "from", "durationInFrames", "cues", "wordRefs", "sourceToOutputMap"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "caption" },
        "from": { "type": "number" },
        "durationInFrames": { "type": "number" },
        "language": { "type": "string" },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "startFrame", "durationInFrames", "text", "wordIds", "sourceStartFrame", "sourceEndFrame"],
            "properties": {
              "id": { "type": "string" },
              "startFrame": { "type": "number" },
              "durationInFrames": { "type": "number" },
              "text": { "type": "string" },
              "wordIds": { "type": "array", "items": { "type": "string" } },
              "sourceStartFrame": { "type": "number" },
              "sourceEndFrame": { "type": "number" }
            }
          }
        },
        "wordRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "sourceStartFrame", "sourceEndFrame"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "sourceStartFrame": { "type": "number" },
              "sourceEndFrame": { "type": "number" }
            }
          }
        },
        "sourceToOutputMap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceStartFrame", "sourceEndFrame", "outputStartFrame", "outputEndFrame"],
            "properties": {
              "sourceStartFrame": { "type": "number" },
              "sourceEndFrame": { "type": "number" },
              "outputStartFrame": { "type": "number" },
              "outputEndFrame": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
