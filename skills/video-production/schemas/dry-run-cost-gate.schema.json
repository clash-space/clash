{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash dry-run cost gate",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "workflowId",
    "stage",
    "status",
    "executionAllowed",
    "maxCostUsd",
    "totalEstimatedCostUsd",
    "operations",
    "blockedReasons",
    "rejectedFallbacks",
    "fallbackUsed",
    "decisionLog",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.workflow.dry-run-cost-gate" },
    "workflowId": { "type": "string" },
    "stage": { "type": "string" },
    "status": { "enum": ["planned", "blocked"] },
    "executionAllowed": { "type": "boolean" },
    "maxCostUsd": { "type": "number" },
    "totalEstimatedCostUsd": { "type": "number" },
    "totalEstimatedSeconds": { "type": "number" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "provider",
          "runtime",
          "mode",
          "availability",
          "estimatedCostUsd",
          "requiresByoKey"
        ],
        "properties": {
          "id": { "type": "string" },
          "capability": { "type": "string" },
          "provider": { "type": "string" },
          "runtime": { "type": "string" },
          "mode": { "enum": ["local", "remote"] },
          "availability": { "enum": ["available", "unavailable", "missing-credentials"] },
          "estimatedCostUsd": { "type": "number" },
          "estimatedSeconds": { "type": "number" },
          "requiresByoKey": { "type": "boolean" }
        }
      }
    },
    "blockedReasons": { "type": "array", "items": { "type": "string" } },
    "rejectedFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromOperationId", "toOperationId", "reason"],
        "properties": {
          "fromOperationId": { "type": "string" },
          "toOperationId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "fallbackUsed": { "const": false },
    "decisionLog": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" }
  }
}
