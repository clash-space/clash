{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash image storyboard consistency metadata",
  "type": "object",
  "required": ["kind", "characters", "scenes", "panels"],
  "properties": {
    "kind": { "const": "image.storyboard-consistency" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "referenceAssetIds"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "referenceAssetIds": { "type": "array", "items": { "type": "string" } },
          "requiredViews": { "type": "array", "items": { "type": "string" } },
          "referenceViews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["view", "assetId", "path", "locked", "copyOnWriteRequired"],
              "properties": {
                "view": { "enum": ["front", "side", "back", "expression", "wardrobe", "pose", "other"] },
                "assetId": { "type": "string" },
                "path": { "type": "string" },
                "locked": { "type": "boolean" },
                "copyOnWriteRequired": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "referenceAssetIds"],
        "properties": {
          "id": { "type": "string" },
          "referenceAssetIds": { "type": "array", "items": { "type": "string" } },
          "prompt": { "type": "string" }
        }
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sceneId", "characterIds"],
        "properties": {
          "id": { "type": "string" },
          "sceneId": { "type": "string" },
          "characterIds": { "type": "array", "items": { "type": "string" } },
          "assetId": { "type": "string" },
          "path": { "type": "string" },
          "consistencyScore": { "type": "number" },
          "prompt": { "type": "string" }
        }
      }
    }
  }
}
