{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash production pipeline validation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "projectKind",
    "pipelinePath",
    "coverage",
    "missingArtifacts",
    "blockedReasons",
    "casRequiredProjectionPaths",
    "artifacts",
    "validatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.production.pipeline-validation" },
    "status": { "enum": ["pass", "blocked"] },
    "projectKind": { "type": "string" },
    "pipelinePath": { "type": "string" },
    "coverage": {
      "type": "object",
      "required": ["action", "metadata", "asset", "projection", "reviewGate", "export"],
      "properties": {
        "action": { "type": "boolean" },
        "metadata": { "type": "boolean" },
        "asset": { "type": "boolean" },
        "projection": { "type": "boolean" },
        "reviewGate": { "type": "boolean" },
        "export": { "type": "boolean" }
      }
    },
    "missingArtifacts": { "type": "array", "items": { "type": "string" } },
    "blockedReasons": { "type": "array", "items": { "type": "string" } },
    "casRequiredProjectionPaths": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "object",
      "required": ["total", "present", "missing", "byKind"],
      "properties": {
        "total": { "type": "number" },
        "present": { "type": "number" },
        "missing": { "type": "number" },
        "byKind": {
          "type": "object",
          "required": ["action", "metadata", "asset", "projection", "reviewGate", "export"],
          "properties": {
            "action": { "$ref": "#/$defs/artifactKindCount" },
            "metadata": { "$ref": "#/$defs/artifactKindCount" },
            "asset": { "$ref": "#/$defs/artifactKindCount" },
            "projection": { "$ref": "#/$defs/artifactKindCount" },
            "reviewGate": { "$ref": "#/$defs/artifactKindCount" },
            "export": { "$ref": "#/$defs/artifactKindCount" }
          }
        }
      }
    },
    "validatedAt": { "type": "string" }
  },
  "$defs": {
    "artifactKindCount": {
      "type": "object",
      "required": ["total", "present"],
      "properties": {
        "total": { "type": "number" },
        "present": { "type": "number" }
      }
    }
  }
}
