{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash timeline NLE handoff",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "sourceTimelineId",
    "sourceTimelinePath",
    "sourceTimelineHash",
    "sourceTimelineRevisionId",
    "sourceTimelineRevisionStatus",
    "format",
    "outputPath",
    "outputs",
    "fps",
    "items",
    "tracks",
    "itemTypes",
    "exportedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.timeline.nle-handoff" },
    "sourceTimelineId": { "type": "string" },
    "sourceTimelinePath": { "type": "string" },
    "sourceTimelineHash": { "type": "string" },
    "sourceTimelineRevisionId": { "type": "string" },
    "sourceTimelineRevisionStatus": { "enum": ["draft-file", "applied"] },
    "format": { "const": "csv" },
    "outputPath": { "type": "string" },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "fps": { "type": "number" },
    "items": { "type": "number" },
    "tracks": { "type": "number" },
    "itemTypes": { "type": "object" },
    "exportedAt": { "type": "string" }
  }
}
