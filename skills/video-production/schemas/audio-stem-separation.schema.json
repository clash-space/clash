{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash audio stem separation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "separationId",
    "sourceAssetId",
    "stems",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.audio.stem-separation" },
    "targetAssetId": { "type": "string" },
    "separationId": { "type": "string" },
    "sourceAssetId": { "type": "string" },
    "sourcePath": { "type": "string" },
    "backendId": { "type": "string" },
    "modelId": { "type": "string" },
    "vocalStemAssetId": { "type": "string" },
    "decisionLog": { "type": "array", "items": { "type": "string" } },
    "stems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stemAssetId",
          "stemType",
          "filePath",
          "fileHash"
        ],
        "properties": {
          "stemAssetId": { "type": "string" },
          "stemType": { "enum": ["vocal", "instrumental", "drums", "bass", "other"] },
          "filePath": { "type": "string" },
          "fileHash": { "type": "string" },
          "codec": { "type": "string" },
          "durationSeconds": { "type": "number" },
          "sampleRate": { "type": "number" },
          "channels": { "type": "number" }
        }
      }
    }
  }
}
