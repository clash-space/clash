{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash ComfyUI runner contract report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "workflowId",
    "workflowPath",
    "workflowHash",
    "apiFormat",
    "models",
    "customNodes",
    "inputs",
    "outputs",
    "execution",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.image.comfyui-runner" },
    "targetAssetId": { "type": "string" },
    "workflowId": { "type": "string" },
    "workflowPath": { "type": "string" },
    "workflowHash": { "type": "string" },
    "apiFormat": { "enum": ["comfyui-api-json", "comfyui-ui-json"] },
    "backendId": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["checkpoint", "vae", "lora", "controlnet", "upscaler", "embedding", "other"] },
          "path": { "type": "string" },
          "hash": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    },
    "customNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "version": { "type": "string" },
          "commit": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodeId", "inputName", "kind"],
        "properties": {
          "id": { "type": "string" },
          "nodeId": { "type": "string" },
          "inputName": { "type": "string" },
          "kind": { "enum": ["text", "image", "mask", "latent", "seed", "number", "model", "lora", "controlnet", "other"] },
          "value": {},
          "assetId": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outputAssetId", "nodeId", "mediaType", "path", "status"],
        "properties": {
          "outputAssetId": { "type": "string" },
          "nodeId": { "type": "string" },
          "outputName": { "type": "string" },
          "mediaType": { "enum": ["image", "image-sequence", "mask", "metadata"] },
          "path": { "type": "string" },
          "fileHash": { "type": "string" },
          "status": { "enum": ["planned", "materialized"] }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["planned", "completed", "failed"] },
        "runnerId": { "type": "string" },
        "promptId": { "type": "string" },
        "executedAt": { "type": "string" }
      }
    },
    "decisionLog": { "type": "array", "items": { "type": "string" } }
  }
}
