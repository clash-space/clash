{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash storyboard consistency QA report",
  "type": "object",
  "required": ["schemaVersion", "kind", "assetPackId", "scores", "verdict", "issues", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.image.storyboard-consistency-qa" },
    "assetPackId": { "type": "string" },
    "scores": {
      "type": "object",
      "required": ["identity", "wardrobe", "scene", "productLogo", "style", "composition", "temporal"],
      "properties": {
        "identity": { "type": "number" },
        "wardrobe": { "type": "number" },
        "scene": { "type": "number" },
        "productLogo": { "type": "number" },
        "style": { "type": "number" },
        "composition": { "type": "number" },
        "temporal": { "type": "number" }
      }
    },
    "verdict": { "enum": ["pass", "warning", "block"] },
    "issues": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "object",
      "required": ["requiredCharacterViews", "panelReferences", "panelAssets", "panelConsistency"],
      "properties": {
        "requiredCharacterViews": {
          "type": "object",
          "required": ["pass", "missing"],
          "properties": {
            "pass": { "type": "boolean" },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["characterId", "view"],
                "properties": {
                  "characterId": { "type": "string" },
                  "view": { "type": "string" }
                }
              }
            }
          }
        },
        "panelReferences": {
          "type": "object",
          "required": ["pass", "unknownSceneIds", "unknownCharacterIds"],
          "properties": {
            "pass": { "type": "boolean" },
            "unknownSceneIds": { "type": "array", "items": { "type": "string" } },
            "unknownCharacterIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "panelAssets": {
          "type": "object",
          "required": ["pass", "missingPathPanelIds"],
          "properties": {
            "pass": { "type": "boolean" },
            "missingPathPanelIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "panelConsistency": {
          "type": "object",
          "required": ["pass", "threshold", "lowScorePanels"],
          "properties": {
            "pass": { "type": "boolean" },
            "threshold": { "type": "number" },
            "lowScorePanels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["panelId", "score"],
                "properties": {
                  "panelId": { "type": "string" },
                  "score": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
