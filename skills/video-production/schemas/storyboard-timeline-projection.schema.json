{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash storyboard timeline projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "storyboardAssetId",
    "sourceActionPath",
    "durationPerPanel",
    "panels",
    "timelineItems",
    "casApply"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.storyboard.timeline-projection" },
    "storyboardAssetId": { "type": "string" },
    "sourceActionPath": { "type": "string" },
    "durationPerPanel": { "type": "number" },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "panelId",
          "sceneId",
          "characterIds",
          "assetId",
          "path",
          "from",
          "durationInFrames"
        ],
        "properties": {
          "panelId": { "type": "string" },
          "sceneId": { "type": "string" },
          "characterIds": { "type": "array", "items": { "type": "string" } },
          "assetId": { "type": "string" },
          "path": { "type": "string" },
          "from": { "type": "number" },
          "durationInFrames": { "type": "number" },
          "consistencyScore": { "type": "number" }
        }
      }
    },
    "timelineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "from",
          "durationInFrames",
          "assetId",
          "src",
          "storyboardPanelId",
          "sceneId"
        ],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "image" },
          "from": { "type": "number" },
          "durationInFrames": { "type": "number" },
          "assetId": { "type": "string" },
          "src": { "type": "string" },
          "storyboardPanelId": { "type": "string" },
          "sceneId": { "type": "string" },
          "characterIds": { "type": "array", "items": { "type": "string" } },
          "consistencyScore": { "type": "number" }
        }
      }
    },
    "casApply": {
      "type": "object",
      "required": ["target", "mutation", "applyCommand", "filePath", "timelineIdPlaceholder", "requiredRuntimeArgs", "pullCommand", "pullArgs", "applyArgs"],
      "properties": {
        "target": { "const": "timeline" },
        "mutation": { "const": "projection-only" },
        "applyCommand": { "const": "clash timeline apply" },
        "filePath": { "type": "string" },
        "timelineIdPlaceholder": { "const": "<timeline-id>" },
        "requiredRuntimeArgs": {
          "type": "array",
          "contains": { "const": "--timeline <timeline-id>" }
        },
        "pullCommand": { "const": "clash timeline pull" },
        "pullArgs": {
          "type": "array",
          "prefixItems": [{ "const": "--timeline" }, { "const": "<timeline-id>" }],
          "items": { "type": "string" }
        },
        "applyArgs": {
          "type": "array",
          "prefixItems": [{ "const": "--timeline" }, { "const": "<timeline-id>" }],
          "items": { "type": "string" }
        }
      }
    }
  }
}
