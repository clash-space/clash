{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash image embedding store report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "embeddingSetId",
    "modelId",
    "dimension",
    "distanceMetric",
    "items",
    "copyOnWriteRequired",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.image.embedding-store" },
    "targetAssetId": { "type": "string" },
    "embeddingSetId": { "type": "string" },
    "modelId": { "type": "string" },
    "dimension": { "type": "number" },
    "distanceMetric": { "enum": ["cosine", "dot", "euclidean"] },
    "copyOnWriteRequired": { "type": "boolean" },
    "decisionLog": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "path",
          "vectorPath",
          "vectorHash",
          "dimension",
          "baselineFor",
          "locked",
          "copyOnWriteRequired",
          "tags"
        ],
        "properties": {
          "assetId": { "type": "string" },
          "roleId": { "type": "string" },
          "subjectId": { "type": "string" },
          "path": { "type": "string" },
          "vectorPath": { "type": "string" },
          "vectorHash": { "type": "string" },
          "dimension": { "type": "number" },
          "baselineFor": {
            "type": "array",
            "items": { "enum": ["identity", "product", "scene", "style", "logo"] }
          },
          "locked": { "type": "boolean" },
          "copyOnWriteRequired": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
