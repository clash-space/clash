{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash audio beat grid",
  "type": "object",
  "required": ["schemaVersion", "audioAssetId", "backend", "bpm", "fps", "beats", "downbeats", "confidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "audioAssetId": { "type": "string" },
    "backend": { "type": "string" },
    "bpm": { "type": "number" },
    "fps": { "type": "number" },
    "tempoCurve": { "type": "array", "items": { "type": "object" } },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "timeMs", "frame", "bar", "beatInBar", "downbeat", "confidence"],
        "properties": {
          "index": { "type": "number" },
          "timeMs": { "type": "number" },
          "frame": { "type": "number" },
          "bar": { "type": "number" },
          "beatInBar": { "type": "number" },
          "downbeat": { "type": "boolean" },
          "confidence": { "type": "number" }
        }
      }
    },
    "downbeats": { "type": "array", "items": { "type": "number" } },
    "barAnchors": { "type": "array", "items": { "type": "number" } },
    "phraseAnchors": { "type": "array", "items": { "type": "number" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "startFrame",
          "endFrame",
          "label",
          "semanticLabel",
          "semanticConfidence",
          "reviewRequired",
          "semanticSource",
          "energy",
          "novelty",
          "impact",
          "cutDensity"
        ],
        "properties": {
          "id": { "type": "string" },
          "startFrame": { "type": "number" },
          "endFrame": { "type": "number" },
          "label": { "type": "string" },
          "semanticLabel": {
            "enum": [
              "intro",
              "verse",
              "pre-chorus",
              "chorus",
              "bridge",
              "drop",
              "buildup",
              "breakdown",
              "outro",
              "instrumental",
              "detected-beats",
              "unknown"
            ]
          },
          "semanticConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reviewRequired": { "type": "boolean" },
          "semanticSource": { "type": "string" },
          "energy": { "type": "number" },
          "novelty": { "type": "number" },
          "impact": { "type": "number" },
          "cutDensity": { "enum": ["hold", "medium", "fast"] }
        }
      }
    },
    "energyCurve": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "timeSeconds", "rms", "normalized", "novelty", "impact"],
        "properties": {
          "frame": { "type": "number" },
          "timeSeconds": { "type": "number" },
          "rms": { "type": "number" },
          "normalized": { "type": "number" },
          "novelty": { "type": "number" },
          "impact": { "type": "number" }
        }
      }
    },
    "confidence": { "type": "number" }
  }
}
