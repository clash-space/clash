{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash product/logo QA report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "requiredReferenceAssetIds",
    "references",
    "checks",
    "verdict",
    "blockedReasons",
    "copyOnWriteRequired"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.image.product-logo-qa" },
    "targetAssetId": { "type": "string" },
    "referencePackAssetId": { "type": "string" },
    "requiredReferenceAssetIds": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "roleId",
          "assetId",
          "role",
          "path",
          "locked",
          "copyOnWriteRequired",
          "constraints"
        ],
        "properties": {
          "roleId": { "type": "string" },
          "assetId": { "type": "string" },
          "role": { "enum": ["logo-lock", "product-packshot"] },
          "subjectId": { "type": "string" },
          "path": { "type": "string" },
          "locked": { "type": "boolean" },
          "copyOnWriteRequired": { "type": "boolean" },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roleId",
          "referenceAssetId",
          "check",
          "status",
          "required",
          "expected",
          "actual"
        ],
        "properties": {
          "id": { "type": "string" },
          "roleId": { "type": "string" },
          "referenceAssetId": { "type": "string" },
          "check": {
            "enum": [
              "logo-presence",
              "glyph-lock",
              "brand-color",
              "packshot-presence",
              "claim-text",
              "material-finish",
              "packaging-layout"
            ]
          },
          "status": { "enum": ["pass", "requires-review", "fail"] },
          "required": { "type": "boolean" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "confidence": { "type": "number" },
          "deltaE": { "type": "number" },
          "evidence": { "type": "string" }
        }
      }
    },
    "verdict": { "enum": ["pass", "requires-review", "fail"] },
    "blockedReasons": { "type": "array", "items": { "type": "string" } },
    "copyOnWriteRequired": { "type": "boolean" }
  }
}
