{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash talking-head ASR transcript projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "transcriptKind",
    "sourcePath",
    "sourceHash",
    "backendId",
    "modelId",
    "wordCount",
    "words"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.talking-head.asr-transcript.projection" },
    "targetAssetId": { "type": "string" },
    "transcriptKind": { "const": "asr-transcript" },
    "sourcePath": { "type": "string" },
    "sourceHash": { "type": "string" },
    "backendId": { "type": "string" },
    "modelId": { "type": "string" },
    "language": { "type": "string" },
    "durationFrames": { "type": "number" },
    "wordCount": { "type": "number" },
    "averageConfidence": { "type": "number" },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "startFrame", "endFrame"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "startFrame": { "type": "number" },
          "endFrame": { "type": "number" },
          "confidence": { "type": "number" },
          "speakerId": { "type": "string" }
        }
      }
    }
  }
}
