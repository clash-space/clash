{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash MG overlay manifest",
  "type": "object",
  "required": ["schemaVersion", "overlayId", "sourcePath", "renderedAssetPath", "casApply", "timelineItems", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "overlayId": { "type": "string" },
    "sourcePath": { "type": "string" },
    "renderedAssetPath": { "type": "string" },
    "casApply": {
      "type": "object",
      "required": ["target", "mutation", "applyCommand", "filePath", "timelineIdPlaceholder", "requiredRuntimeArgs", "pullCommand", "pullArgs", "applyArgs"],
      "properties": {
        "target": { "const": "timeline" },
        "mutation": { "const": "projection-only" },
        "applyCommand": { "const": "clash timeline apply" },
        "filePath": { "type": "string" },
        "timelineIdPlaceholder": { "const": "<timeline-id>" },
        "requiredRuntimeArgs": {
          "type": "array",
          "contains": { "const": "--timeline <timeline-id>" }
        },
        "pullCommand": { "const": "clash timeline pull" },
        "pullArgs": {
          "type": "array",
          "prefixItems": [{ "const": "--timeline" }, { "const": "<timeline-id>" }],
          "items": { "type": "string" }
        },
        "applyArgs": {
          "type": "array",
          "prefixItems": [{ "const": "--timeline" }, { "const": "<timeline-id>" }],
          "items": { "type": "string" }
        }
      }
    },
    "timelineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "compositionKind", "runtime", "compositionId", "sourcePath", "renderedAssetPath", "from", "durationInFrames"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "composition" },
          "compositionKind": { "const": "motion-graphics" },
          "runtime": { "const": "html" },
          "compositionId": { "type": "string" },
          "sourcePath": { "type": "string" },
          "renderedAssetPath": { "type": "string" },
          "from": { "type": "number" },
          "durationInFrames": { "type": "number" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "durationFrames",
        "dimensions",
        "htmlPreview",
        "seekablePreview",
        "currentFrameState",
        "frameEvent",
        "renderRequired",
        "externalRuntime",
        "implementation"
      ],
      "properties": {
        "durationFrames": { "type": "number" },
        "dimensions": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "htmlPreview": { "type": "boolean" },
        "seekablePreview": { "const": true },
        "currentFrameState": { "const": "data-current-frame" },
        "frameEvent": { "const": "clash-mg-frame" },
        "renderRequired": { "type": "boolean" },
        "externalRuntime": { "const": false },
        "implementation": {
          "type": "object",
          "required": [
            "renderer",
            "source",
            "license",
            "thirdPartyCodeCopied",
            "externalRuntime",
            "researchReferences"
          ],
          "properties": {
            "renderer": { "const": "clash-first-party-mg-composition" },
            "source": { "const": "first-party" },
            "license": { "const": "MIT" },
            "thirdPartyCodeCopied": { "const": false },
            "externalRuntime": { "const": false },
            "researchReferences": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
