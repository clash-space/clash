{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash lyrics alignment",
  "type": "object",
  "required": ["schemaVersion", "kind", "audioAssetId", "fps", "lyricsSource", "units", "unmatchedRanges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.audio.lyrics-alignment.projection" },
    "audioAssetId": { "type": "string" },
    "targetAssetId": { "type": "string" },
    "fps": { "type": "number" },
    "lyricsSource": { "type": "string" },
    "vocalStemAssetId": { "type": "string" },
    "reviewRequired": { "type": "boolean" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lineId", "text", "startMs", "endMs", "startFrame", "endFrame", "confidence", "source"],
        "properties": {
          "lineId": { "type": "string" },
          "wordId": { "type": "string" },
          "text": { "type": "string" },
          "startMs": { "type": "number" },
          "endMs": { "type": "number" },
          "startFrame": { "type": "number" },
          "endFrame": { "type": "number" },
          "confidence": { "type": "number" },
          "source": { "type": "string" }
        }
      }
    },
    "unmatchedRanges": { "type": "array", "items": { "type": "object" } },
    "captionProjection": {
      "type": "object",
      "required": ["filePath", "trackRole", "itemType"],
      "properties": {
        "filePath": { "type": "string" },
        "trackRole": { "type": "string" },
        "itemType": { "const": "caption" }
      }
    }
  }
}
