{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash content credentials report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "credentialId",
    "mode",
    "signatureStatus",
    "ingredients",
    "actions",
    "assertions",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.provenance.content-credentials" },
    "targetAssetId": { "type": "string" },
    "credentialId": { "type": "string" },
    "targetPath": { "type": "string" },
    "targetHash": { "type": "string" },
    "mode": { "enum": ["unsigned-manifest", "signed-c2pa", "external"] },
    "signatureStatus": { "enum": ["unsigned", "signed", "external", "failed"] },
    "c2paManifestPath": { "type": "string" },
    "c2paManifestHash": { "type": "string" },
    "issuer": { "type": "string" },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "relationship"],
        "properties": {
          "assetId": { "type": "string" },
          "path": { "type": "string" },
          "relationship": { "enum": ["source", "reference", "generated-input", "model", "metadata"] },
          "hash": { "type": "string" },
          "title": { "type": "string" },
          "rights": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "actionId": { "type": "string" },
          "action": { "type": "string" },
          "softwareAgent": { "type": "string" },
          "when": { "type": "string" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "path": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "decisionLog": { "type": "array", "items": { "type": "string" } }
  }
}
