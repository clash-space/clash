{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash reference isolation verification report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "sourceTimelinePath",
    "assetsPath",
    "rawReferenceAssets",
    "timelineItems",
    "offenders",
    "checks",
    "blockedReasons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.reference.isolation-verification" },
    "status": { "enum": ["pass", "blocked"] },
    "sourceTimelinePath": { "type": "string" },
    "assetsPath": { "type": "string" },
    "rawReferenceAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "finalExportAllowed",
          "redistributionAllowed",
          "derivativeAllowed",
          "downloadedPaths"
        ],
        "properties": {
          "assetId": { "type": "string" },
          "path": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "finalExportAllowed": { "type": "boolean" },
          "redistributionAllowed": { "type": "boolean" },
          "derivativeAllowed": { "type": "boolean" },
          "downloadedPaths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "timelineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trackId", "itemId"],
        "properties": {
          "trackId": { "type": "string" },
          "itemId": { "type": "string" },
          "assetId": { "type": "string" },
          "src": { "type": "string" }
        }
      }
    },
    "offenders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trackId", "itemId", "reason"],
        "properties": {
          "trackId": { "type": "string" },
          "itemId": { "type": "string" },
          "assetId": { "type": "string" },
          "src": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "reason": {
            "enum": [
              "timeline item uses quarantined raw reference without final export rights",
              "timeline item uses raw reference path without final export rights"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "required", "status", "expected", "actual"],
        "properties": {
          "id": {
            "enum": [
              "assets.raw-reference-quarantine-known",
              "timeline.valid",
              "timeline.no-unlicensed-raw-reference-assets",
              "timeline.no-unlicensed-raw-reference-paths"
            ]
          },
          "label": { "type": "string" },
          "required": { "const": true },
          "status": { "enum": ["pass", "fail"] },
          "expected": { "type": "string" },
          "actual": { "type": "string" }
        }
      }
    },
    "blockedReasons": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "offenders": { "maxItems": 0 },
          "blockedReasons": { "maxItems": 0 }
        }
      }
    }
  ]
}
