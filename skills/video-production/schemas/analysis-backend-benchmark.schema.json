{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash analysis backend benchmark report",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "benchmarkId",
    "targetAssetId",
    "targetCapability",
    "fixtureSetPath",
    "candidates",
    "verdict",
    "blockedReasons",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.analysis.backend-benchmark" },
    "benchmarkId": { "type": "string" },
    "targetAssetId": { "type": "string" },
    "targetCapability": { "type": "string" },
    "fixtureSetPath": { "type": "string" },
    "selectedBackendId": { "type": "string" },
    "verdict": { "enum": ["pass", "requires-review", "fail"] },
    "blockedReasons": { "type": "array", "items": { "type": "string" } },
    "decisionLog": { "type": "array", "items": { "type": "string" } },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backendId", "capability", "resultPath", "metrics", "weightedScore", "status"],
        "properties": {
          "backendId": { "type": "string" },
          "capability": { "type": "string" },
          "resultPath": { "type": "string" },
          "weightedScore": { "type": "number" },
          "status": { "enum": ["pass", "fail"] },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "score", "threshold", "weight", "higherIsBetter", "status"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "score": { "type": "number" },
                "threshold": { "type": "number" },
                "weight": { "type": "number" },
                "higherIsBetter": { "type": "boolean" },
                "status": { "enum": ["pass", "fail"] }
              }
            }
          }
        }
      }
    }
  }
}
