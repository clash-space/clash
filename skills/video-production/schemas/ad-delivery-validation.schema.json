{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash ad delivery export validation receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "brand",
    "variant",
    "renderedPath",
    "probe",
    "visualQa",
    "checks",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.ad.delivery-export-validation" },
    "targetAssetId": { "type": "string" },
    "brand": { "type": "string" },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "platform",
        "durationSeconds",
        "width",
        "height",
        "aspectRatio",
        "safeZones",
        "subtitlesRequired",
        "loudnessTarget"
      ],
      "properties": {
        "id": { "type": "string" },
        "platform": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "aspectRatio": { "type": "string" },
        "safeZones": {
          "type": "object",
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          }
        },
        "subtitlesRequired": { "type": "boolean" },
        "loudnessTarget": { "type": "string" }
      }
    },
    "renderedPath": { "type": "string" },
    "probe": {
      "type": "object",
      "required": ["width", "height", "fps", "durationSeconds", "hasVideo", "hasAudio"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "fps": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "hasVideo": { "type": "boolean" },
        "hasAudio": { "type": "boolean" },
        "videoCodec": { "type": "string" },
        "audioCodec": { "type": "string" }
      }
    },
    "visualQa": {
      "type": "object",
      "required": ["captionsPresent", "safeZoneViolations", "packshotVisible", "endCardVisible"],
      "properties": {
        "captionsPresent": { "type": "boolean" },
        "safeZoneViolations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "severity"],
            "properties": {
              "frame": { "type": "number" },
              "description": { "type": "string" },
              "severity": { "enum": ["warning", "error"] }
            }
          }
        },
        "packshotVisible": { "type": "boolean" },
        "endCardVisible": { "type": "boolean" },
        "disclaimerVisible": { "type": "boolean" },
        "ctaVisible": { "type": "boolean" },
        "logoLockupVisible": { "type": "boolean" },
        "finalFrameHolds": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "required", "severity", "expected", "actual"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "required": { "type": "boolean" },
          "severity": { "enum": ["error", "warning"] },
          "expected": { "type": "string" },
          "actual": { "type": "string" }
        }
      }
    },
    "verdict": { "enum": ["pass", "fail"] }
  }
}
