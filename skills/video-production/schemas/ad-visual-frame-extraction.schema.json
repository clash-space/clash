{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash ad visual frame extraction",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "variantId",
    "renderedPath",
    "extractor",
    "samples",
    "decisionLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.ad.visual-frame-extraction" },
    "targetAssetId": { "type": "string" },
    "variantId": { "type": "string" },
    "renderedPath": { "type": "string" },
    "extractor": {
      "type": "object",
      "required": ["id", "command"],
      "properties": {
        "id": { "const": "ffmpeg" },
        "command": { "const": "ffmpeg" }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "frame", "path", "format"],
        "properties": {
          "id": {
            "enum": ["packshot-frame", "end-card-frame", "final-frame"]
          },
          "role": {
            "enum": ["packshot", "end-card", "final-frame"]
          },
          "frame": { "type": "number" },
          "path": { "type": "string" },
          "format": { "const": "ppm" }
        }
      }
    },
    "decisionLog": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
