{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash ad delivery spec projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "targetAssetId",
    "brand",
    "fps",
    "platforms",
    "variants",
    "packshot",
    "endCard",
    "checklist"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.ad.delivery-spec.projection" },
    "targetAssetId": { "type": "string" },
    "brand": { "type": "string" },
    "fps": { "type": "number" },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform",
          "durationSeconds",
          "width",
          "height",
          "aspectRatio",
          "safeZones",
          "subtitlesRequired",
          "loudnessTarget"
        ],
        "properties": {
          "id": { "type": "string" },
          "platform": { "type": "string" },
          "durationSeconds": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "aspectRatio": { "type": "string" },
          "safeZones": {
            "type": "object",
            "required": ["top", "right", "bottom", "left"],
            "properties": {
              "top": { "type": "number" },
              "right": { "type": "number" },
              "bottom": { "type": "number" },
              "left": { "type": "number" }
            }
          },
          "subtitlesRequired": { "type": "boolean" },
          "loudnessTarget": { "type": "string" }
        }
      }
    },
    "packshot": {
      "type": "object",
      "required": ["required", "assetId", "startFrame", "endFrame"],
      "properties": {
        "required": { "type": "boolean" },
        "assetId": { "type": "string" },
        "startFrame": { "type": "number" },
        "endFrame": { "type": "number" }
      }
    },
    "endCard": {
      "type": "object",
      "required": ["required", "durationFrames", "cta", "qrRequired"],
      "properties": {
        "required": { "type": "boolean" },
        "durationFrames": { "type": "number" },
        "cta": { "type": "string" },
        "disclaimer": { "type": "string" },
        "qrRequired": { "type": "boolean" }
      }
    },
    "rightsLedgerAssetId": { "type": "string" },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "required"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
