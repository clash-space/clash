{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clash composition route plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "compositionId",
    "compositionKind",
    "status",
    "selectedRuntime",
    "fallbackUsed",
    "routeCommand",
    "requirements",
    "availableRuntimes",
    "validationPlan",
    "decisionLog",
    "blockedReasons",
    "rejectedFallbacks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "clash.render.composition-route" },
    "compositionId": { "type": "string" },
    "compositionKind": { "type": "string" },
    "status": { "enum": ["planned", "blocked"] },
    "selectedRuntime": { "enum": ["html", "remotion", "ffmpeg", "manim", null] },
    "fallbackUsed": { "const": false },
    "routeCommand": {},
    "requirements": { "type": "array", "items": { "type": "string" } },
    "availableRuntimes": {
      "type": "array",
      "items": { "enum": ["html", "remotion", "ffmpeg", "manim"] }
    },
    "inputPath": { "type": "string" },
    "outputPath": { "type": "string" },
    "validationPlan": { "type": "array", "items": { "type": "string" } },
    "decisionLog": { "type": "array", "items": { "type": "string" } },
    "blockedReasons": { "type": "array", "items": { "type": "string" } },
    "rejectedFallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "reason"],
        "properties": {
          "runtime": { "enum": ["html", "remotion", "ffmpeg", "manim"] },
          "reason": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string" }
  }
}
