{
  "name": "@clash/local-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/dev.ts",
    "start": "tsx --tsconfig tsconfig.dev.json src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "tsx --tsconfig tsconfig.dev.json e2e/daemon-smoke.ts",
    "test:providers": "vitest run src/google-backend.e2e.test.ts src/minimax-backend.e2e.test.ts src/hilo-backend.e2e.test.ts src/volcengine-backend.e2e.test.ts src/volcengine-provider-e2e-cases.test.ts",
    "test:providers:live": "vitest run src/real-generation-google.test.ts src/real-generation-minimax.test.ts src/real-generation-hilo.test.ts",
    "test:google-agent-platform": "tsx scripts/google-agent-platform-conformance.ts",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.47.0",
    "@agentclientprotocol/sdk": "^0.28.1",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@clash-plugin/codex-imagegen": "workspace:*",
    "@clash-plugin/fal": "workspace:*",
    "@clash-plugin/google": "workspace:*",
    "@clash-plugin/minimax": "workspace:*",
    "@clash-plugin/pika": "workspace:*",
    "@clash-plugin/volcengine": "workspace:*",
    "@clash/asset-sdk": "workspace:*",
    "@clash/sdk": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@openma/common": "github:openma-ai/openma-common#codex/acp-lifecycle-v05",
    "hono": "^4.7.10",
    "loro-crdt": "^1.10.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@mswjs/interceptors": "^0.42.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
