{
  "name": "@master-clash/local-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build:deps": "npm --prefix ../../packages/shared-runtime run build && npm --prefix ../../packages/shared-types run build && npm --prefix ../../packages/clash-sdk/js run build && npm --prefix ../../packages/cli run build && npm --prefix ../../plugins/first-party-media run build && npm --prefix ../../plugins/codex-imagegen run build && npm --prefix ../../packages/clash-bridge run build:runtime",
    "build": "tsc",
    "build:with-deps": "npm run build:deps && tsc",
    "type-check": "npm run build:deps && tsc --noEmit",
    "test": "npm run build:deps && vitest run src",
    "test:e2e": "npm run build:with-deps && node e2e/daemon-smoke.mjs",
    "test:providers": "tsx scripts/provider-conformance.ts",
    "test:google-agent-platform": "tsx scripts/google-agent-platform-conformance.ts",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@clash-plugin/first-party-media": "workspace:*",
    "@clash-plugin/codex-imagegen": "workspace:*",
    "@clash-space/bridge": "workspace:*",
    "@clash-space/cli": "workspace:*",
    "@clash-space/sdk": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@clash/shared-types": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.10",
    "loro-crdt": "^1.10.3",
    "yaml": "^2.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
