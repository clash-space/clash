{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@clash-space/sdk": ["../../packages/clash-sdk/js/src/index.ts"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
