{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-web-next",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "observability": { "enabled": true },

  // Staging subdomain for the migration. clash.video stays on the
  // placeholder Worker until web-tanstack reaches feature parity.
  "routes": [
    { "pattern": "next.clash.video", "custom_domain": true }
  ],

  // Shared OSS DB (users, projects, sessions). Same id as apps/web/wrangler.toml.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "master-clash-frontend",
      "database_id": "aab16eeb-a375-490b-ad1e-cd092cd9f4bb"
    }
  ],

  // R2 for assets — same bucket as the OSS deploy.
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "master-clash-assets"
    }
  ],

  // Service binding: web-tanstack proxies /api/* requests to the hosted
  // API Worker. master-clash-api-hosted runs the OSS api-cf code + the
  // proprietary billing plugin + auth-gated v1 routes.
  "services": [
    { "binding": "API_CF", "service": "master-clash-api-hosted" }
  ],

  "vars": {
    "BETTER_AUTH_BASE_PATH": "/api/better-auth"
  }

  // Secrets to set via `wrangler secret put`:
  //   BETTER_AUTH_SECRET   — session signing
  //   AUTH_GOOGLE_ID       — Google OAuth client id
  //   AUTH_GOOGLE_SECRET   — Google OAuth client secret
}
