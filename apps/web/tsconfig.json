{
  "include": ["**/*.ts", "**/*.tsx", "workers/**/*.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "~/*": ["./app/*"],
      "@clash/gui": ["../../packages/gui/src/index.ts"],
      "@clash/gui/*": ["../../packages/gui/src/*"],
      "@clash/action-sdk/browser": ["../../packages/action-sdk/src/browser.ts"],
      "@clash/shared-layout": ["../../packages/shared-layout/src/index.ts"],
      "@clash/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@clash/shared-types/*": ["../../packages/shared-types/src/*.ts"],
      "@clash/shared-runtime": ["../../packages/shared-runtime/src/browser.ts"],
      "@clash/shared-runtime/local-paths": [
        "../../packages/shared-runtime/src/local-paths.ts"
      ]
    },
    "noEmit": true
  }
}
