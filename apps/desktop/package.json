{
  "name": "@clash/desktop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "description": "Clash desktop app",
  "author": "hrhrng <hrhrng@foxmail.com>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/dev.ts",
    "pack:dir": "electron-builder --dir --config electron-builder.yml",
    "pack:dmg": "electron-builder --mac dmg --arm64 --config electron-builder.yml --publish never",
    "pack:mac": "pnpm pack:mac:arm64",
    "pack:mac:arm64": "electron-builder --mac dmg --arm64 --config electron-builder.yml --publish never",
    "pack:mac:x64": "electron-builder --mac dmg --x64 --config electron-builder.yml --publish never",
    "pack:mac:universal": "electron-builder --mac dmg --universal --config electron-builder.yml --publish never",
    "pack:win": "electron-builder --win nsis --x64 --config electron-builder.yml --publish never",
    "pack:linux": "electron-builder --linux AppImage --x64 --config electron-builder.yml --publish never",
    "prepare:harnesses": "node scripts/prepare-acp-harnesses.mjs",
    "prepare:pack": "node scripts/prepare-clash-cli.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit --project tsconfig.dev.json",
    "test": "vitest run",
    "test:agent:real-codex": "pnpm prepare:harnesses && CLASH_E2E_REAL_CODEX=1 node e2e/real-codex-acp-backend.mjs",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:agent-browser": "node e2e/agent-browser-smoke.mjs",
    "test:e2e:voice-input": "node e2e/voice-input-agent-browser.mjs",
    "test:e2e:timeline-keyframes": "node e2e/timeline-keyframes-agent-browser.mjs",
    "test:e2e:director-stage-webgl": "node e2e/director-stage-webgl-smoke.mjs",
    "test:e2e:agent-first-local-v1": "node e2e/agent-first-local-v1-gate.mjs",
    "test:e2e:asset-receipts": "tsx e2e/agent-first-asset-receipt-smoke.mjs",
    "test:e2e:agent-first-cas": "node e2e/agent-first-cas-smoke.mjs",
    "test:e2e:qa-agent": "node e2e/qa-agent-codex.mjs",
    "test:e2e:project-workspace-cli": "tsx e2e/project-workspace-cli-smoke.ts",
    "test:e2e:short-drama-timeline": "node e2e/short-drama-timeline-smoke.mjs",
    "test:e2e:storage-doctor-repair": "node e2e/storage-doctor-repair-smoke.mjs",
    "test:startup": "pnpm test:startup:static && pnpm test:startup:ui",
    "test:startup:queue": "node e2e/queue-agent-browser-smoke.mjs",
    "test:startup:providers": "node e2e/provider-gui-smoke.mjs",
    "test:startup:harness-update-gui": "CLASH_E2E_STATIC_WEB=1 node e2e/harness-update-agent-browser.mjs",
    "test:startup:real-codex-cold": "node scripts/prepare-clash-cli.mjs && pnpm prepare:harnesses && CLASH_E2E_REAL_CODEX=1 node e2e/real-codex-cold-start-agent-browser.mjs",
    "test:startup:real-codex": "node scripts/prepare-clash-cli.mjs && pnpm prepare:harnesses && CLASH_E2E_REAL_CODEX=1 node e2e/real-codex-agent-browser.mjs",
    "test:startup:real-codex-resume": "node scripts/prepare-clash-cli.mjs && pnpm prepare:harnesses && CLASH_E2E_REAL_CODEX=1 node e2e/real-codex-resume-agent-browser.mjs",
    "test:startup:static": "node scripts/prepare-clash-cli.mjs && pnpm prepare:harnesses && node e2e/startup-static.mjs",
    "test:startup:ui": "node e2e/startup-ui-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.507",
    "@clash/shared-runtime": "workspace:*"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.47.0",
    "@agentclientprotocol/codex-acp": "^1.1.7",
    "@clash/cli": "workspace:*",
    "@clash/local-api": "workspace:*",
    "@clash/render-server": "workspace:*",
    "clash": "workspace:*",
    "@remotion/bundler": "4.0.507",
    "@types/node": "^24.0.0",
    "electron": "^42.3.2",
    "electron-builder": "26.15.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
