{
  "name": "@master-clash/api-cf-hosted",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted entry point for api-cf — installs proprietary plugins (billing, BYOK keys) on top of the OSS api-cf core.",
  "scripts": {
    "dev": "wrangler dev --port 8790 --inspector-port 9334 --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@master-clash/api-cf": "workspace:*",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.18.0"
  }
}
