{
  "name": "@clash-space/cli",
  "version": "0.1.0-beta.3",
  "description": "Clash CLI \u2014 manage projects and canvas from your terminal",
  "bin": {
    "clash": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "npm --prefix ../shared-runtime run build && tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "npm --prefix ../shared-runtime run build && node scripts/run-tests.mjs",
    "test:e2e": "node --test e2e/canvas-add-refs.test.mjs"
  },
  "dependencies": {
    "@clash-space/bridge": "workspace:*",
    "@clash-space/mcp-server": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@master-clash/remotion-effects": "workspace:*",
    "ajv": "^8.20.0",
    "commander": "^13.0.0",
    "esbuild": "^0.25.0",
    "loro-crdt": "^1.10.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@clash/shared-layout": "workspace:^",
    "@clash/shared-types": "workspace:*",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "files": [
    "dist"
  ]
}
