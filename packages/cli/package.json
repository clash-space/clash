{
  "name": "@clash-space/cli",
  "version": "0.1.0-beta.3",
  "description": "Clash CLI — manage projects and canvas from your terminal",
  "bin": {
    "clash": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node --test e2e/canvas-add-refs.test.mjs"
  },
  "dependencies": {
    "@clash/shared-runtime": "workspace:*",
    "commander": "^13.0.0",
    "loro-crdt": "^1.10.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@clash/shared-layout": "workspace:^",
    "@clash/shared-types": "workspace:*",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "files": [
    "dist"
  ]
}
