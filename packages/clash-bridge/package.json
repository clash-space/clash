{
  "name": "@clash-space/bridge",
  "version": "0.1.0-beta.30",
  "description": "Clash bridge — pair a local Claude Code (or other ACP agent) with the Clash web UI.",
  "private": true,
  "type": "module",
  "bin": {
    "clash-bridge": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./acp-runtime": {
      "types": "./src/_acp-runtime/index.ts",
      "import": "./dist/acp-runtime.js",
      "default": "./dist/acp-runtime.js"
    },
    "./cc-sessions": {
      "types": "./src/lib/cc-sessions.ts",
      "import": "./dist/cc-sessions.js",
      "default": "./dist/cc-sessions.js"
    },
    "./platform": {
      "types": "./src/lib/platform.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./session-manager": {
      "types": "./src/lib/session-manager.ts",
      "import": "./dist/session-manager.js",
      "default": "./dist/session-manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm bundle:crew",
    "bundle:crew": "node scripts/bundle-crew.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
