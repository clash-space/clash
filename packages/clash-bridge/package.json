{
  "name": "@clash-space/bridge",
  "version": "0.1.0-beta.25",
  "description": "Clash bridge — pair a local Claude Code (or other ACP agent) with the Clash web UI.",
  "private": true,
  "type": "module",
  "bin": {
    "clash-bridge": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm bundle:cc-config",
    "bundle:cc-config": "rm -rf dist/cc-config && mkdir -p dist/cc-config && cp -R assets/cc/. dist/cc-config/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
