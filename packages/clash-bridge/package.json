{
  "name": "@clash-space/bridge",
  "version": "0.1.0-beta.30",
  "description": "Clash bridge — pair a local ACP agent with the Clash web UI.",
  "private": true,
  "type": "module",
  "bin": {
    "clash-bridge": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./acp-runtime": {
      "types": "./src/_acp-runtime/index.ts",
      "import": "./dist/acp-runtime.js",
      "default": "./dist/acp-runtime.js"
    },
    "./cc-sessions": {
      "types": "./src/lib/cc-sessions.ts",
      "import": "./dist/cc-sessions.js",
      "default": "./dist/cc-sessions.js"
    },
    "./platform": {
      "types": "./src/lib/platform.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./session-manager": {
      "types": "./src/lib/session-manager.ts",
      "import": "./dist/session-manager.js",
      "default": "./dist/session-manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm --prefix ../shared-runtime run build && tsup && node scripts/bundle-agents.mjs",
    "bundle:agents": "node scripts/bundle-agents.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "npm --prefix ../shared-runtime run build && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.47.0",
    "@agentclientprotocol/sdk": "^0.28.1",
    "@clash/shared-runtime": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  }
}
