{
  "name": "@clash/artifact-evals",
  "version": "0.1.0",
  "description": "Artifact-first headless agent benchmark runner for Clash creative workflows",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "clash-artifact-bench": "./src/cli.ts"
  },
  "scripts": {
    "benchmark": "tsx src/cli.ts",
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clash/shared-types": "workspace:*",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
