{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@clash/asset-sdk": ["../../asset-sdk/src/index.ts"],
      "@clash/gui": ["../../gui/src/index.ts"],
      "@clash/gui/*": ["../../gui/src/*"],
      "@clash/shared-layout": ["../../shared-layout/src/index.ts"],
      "@clash/shared-types": ["../../shared-types/src/index.ts"],
      "@clash/shared-types/*": ["../../shared-types/src/*.ts"],
      "@clash/shared-runtime": ["../../shared-runtime/src/browser.ts"],
      "@clash/shared-runtime/*": ["../../shared-runtime/src/*.ts"]
    }
  },
  "include": ["src/**/*"]
}
