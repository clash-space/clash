{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "codex-imagegen-basic",
  "description": "Projects prompt and aspect ratio into the Codex ImageGen host capability and returns its asset.",
  "target": {
    "exportId": "generate-image",
    "kind": "action"
  },
  "context": {
    "projectId": "contract-test-project"
  },
  "input": {
    "values": {
      "prompt": "A paper-cut moon",
      "aspect_ratio": "16:9"
    },
    "references": []
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "codex.image.generate",
        "prompt": "A paper-cut moon",
        "aspectRatio": "16:9",
        "slot": "image",
        "references": []
      },
      "response": {
        "status": "ok",
        "result": {
          "assetId": "contract-image",
          "uri": "clash-asset://contract-image",
          "kind": "image",
          "mediaType": "image/png"
        }
      }
    }
  ],
  "expect": {
    "status": "completed",
    "outputs": [
      {
        "slot": "image",
        "kind": "asset",
        "asset": {
          "assetId": "contract-image",
          "uri": "clash-asset://contract-image",
          "kind": "image",
          "mediaType": "image/png"
        }
      }
    ]
  },
  "timeoutMs": 10000
}
