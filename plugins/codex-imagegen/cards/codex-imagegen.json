{
  "apiVersion": "clash.card/v1",
  "kind": "action-card",
  "spec": {
    "id": "codex-imagegen",
    "name": "Codex ImageGen",
    "description": "Create or edit an image with Codex's built-in ImageGen tool. Uses the locally signed-in ChatGPT subscription; no API key is required.",
    "parameters": [
      {
        "id": "aspect_ratio",
        "label": "Aspect Ratio",
        "type": "select",
        "required": false,
        "options": [
          { "label": "Square (1:1)", "value": "1:1" },
          { "label": "Landscape (16:9)", "value": "16:9" },
          { "label": "Portrait (9:16)", "value": "9:16" },
          { "label": "Landscape (4:3)", "value": "4:3" },
          { "label": "Portrait (3:4)", "value": "3:4" },
          { "label": "Ultrawide (21:9)", "value": "21:9" }
        ],
        "defaultValue": "1:1"
      }
    ],
    "outputType": "image",
    "presentation": { "type": "form" },
    "input": {
      "requiresPrompt": true,
      "inputMode": {
        "images": { "max": 5 }
      },
      "promptModalities": ["text", "image"]
    },
    "functionExportId": "generate-image",
    "maxRuntimeMs": 600000
  }
}
