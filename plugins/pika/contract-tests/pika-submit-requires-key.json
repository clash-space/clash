{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "pika-submit-requires-key",
  "description": "A submit without the selected Pika account's API key fails before any Provider request.",
  "target": {
    "exportId": "pika-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "kind": "image",
      "modelId": "gemini-3.1-flash-image",
      "upstreamModel": "google/gemini-3.1-flash-image",
      "prompt": "A small red robot"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This Pika account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
