{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "pika",
    "name": "Pika API Club",
    "upstreamId": "pika",
    "apiShape": "pika",
    "executorExportId": "pika-execute",
    "auth": {
      "methods": [
        {
          "id": "api-key",
          "label": "API key",
          "form": [
            {
              "kind": "notice",
              "text": "Create a Pika API Club key at dev.pika.art/login. Clash stores it as an account secret and never exposes it to browser code."
            },
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            }
          ]
        }
      ]
    }
  }
}
