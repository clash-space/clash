{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.tripo",
  "version": "0.1.0",
  "name": "Tripo3D",
  "description": "Tripo3D text-to-3D, image-to-3D and auto-rigging Provider bindings and executor for the built-in tripo-h3.1 and tripo-auto-rig model Cards.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "tripo-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      }
    ],
    "providers": [
      {
        "id": "tripo",
        "kind": "provider",
        "path": "providers/tripo.json"
      }
    ],
    "modelBindings": [
      {
        "id": "tripo-h3.1",
        "kind": "model-provider-binding",
        "path": "bindings/tripo-h3.1.json"
      },
      {
        "id": "tripo-auto-rig",
        "kind": "model-provider-binding",
        "path": "bindings/tripo-auto-rig.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/tripo-submit-requires-key.json",
    "contract-tests/tripo-poll-rejects-state.json",
    "contract-tests/tripo-auto-rig-requires-reference.json"
  ],
  "author": "Clash local third-party"
}
