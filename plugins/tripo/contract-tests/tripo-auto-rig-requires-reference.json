{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "tripo-auto-rig-requires-reference",
  "description": "tripo-auto-rig rejects a submit with no reference in slot model before any Provider request.",
  "target": {
    "exportId": "tripo-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "modelId": "tripo-auto-rig",
      "upstreamModel": "v1.0-20240301"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "invalid_request",
      "message": "Tripo auto-rig requires a reference in slot model.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": { "value": "sk-test" }
      }
    }
  ]
}
