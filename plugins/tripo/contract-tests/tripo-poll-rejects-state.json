{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "tripo-poll-rejects-state",
  "description": "A resumed Tripo run rejects an unusable durable poll state before reading account data.",
  "target": {
    "exportId": "tripo-execute",
    "kind": "provider-executor"
  },
  "operation": "poll",
  "pollState": {},
  "input": {
    "values": {
      "modelId": "tripo-h3.1",
      "upstreamModel": "v3.1-20260211"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "contract_violation",
      "message": "Tripo poll state is missing its taskId.",
      "retryable": false,
      "requestState": "accepted"
    }
  }
}
