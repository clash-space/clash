{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "hilo-hub",
    "name": "MiniMax Hub (Overseas)",
    "description": "Overseas MiniMax Hub media generation through normal Hub OAuth or explicit reuse of the local Hub login.",
    "upstreamId": "hilo-hub",
    "apiShape": "hilo-hub",
    "executorExportId": "hilo-hub-execute",
    "auth": {
      "methods": [
        {
          "id": "reuse-local-login",
          "label": "Reuse MiniMax Hub login",
          "import": {
            "format": "electron-store-aes-256-gcm-v2",
            "appDataSubdirectory": "@hilo/MiniMax Hub Global",
            "configFile": "hub-config-global.json",
            "keyFile": ".token-key",
            "tokenPath": [
              "tokens",
              "accessToken"
            ],
            "storeAs": "accessToken"
          }
        },
        {
          "id": "sign-in",
          "label": "Sign in to MiniMax Hub",
          "flow": {
            "open": "https://hub.minimax.io/login?device_id=clash-desktop&version_code=2.0.11",
            "callback": {
              "type": "scheme",
              "scheme": "minimax-hub"
            },
            "credential": {
              "from": "query",
              "name": "accessToken",
              "storeAs": "accessToken"
            }
          }
        },
        {
          "id": "token",
          "label": "Paste an access token",
          "form": [
            {
              "kind": "field",
              "key": "accessToken",
              "label": "Access token",
              "secret": true
            }
          ]
        }
      ]
    },
    "bindingDefaults": {
      "priority": 5,
      "assetInputs": [
        {
          "match": {
            "kinds": ["image", "video", "audio"]
          },
          "representations": ["provider-url", "bytes"]
        }
      ]
    }
  }
}
