{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "hilo-hub-execute-refuses-an-unsupported-model",
  "description": "A model this plugin has no route for is refused before any credential is read.",
  "target": {
    "exportId": "hilo-hub-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "modelId": "not-a-model",
      "upstreamModel": "not-a-model",
      "prompt": "anything"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "execution_failed",
      "message": "Unsupported Hilo Hub model: not-a-model",
      "retryable": false
    }
  }
}
