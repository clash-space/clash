{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "volcengine-mediakit",
    "name": "Volcengine MediaKit",
    "description": "Volcengine AI MediaKit video enhancement.",
    "upstreamId": "volcengine-mediakit",
    "apiShape": "mediakit",
    "executorExportId": "volcengine-mediakit-execute",
    "auth": {
      "methods": [
        {
          "id": "mediakit-api-key",
          "label": "MediaKit API key",
          "form": [
            {
              "kind": "field",
              "key": "apiKey",
              "label": "MediaKit API key",
              "secret": true
            },
            {
              "kind": "field",
              "key": "baseUrl",
              "label": "MediaKit Base URL",
              "default": "https://mediakit.cn-beijing.volces.com"
            }
          ]
        }
      ]
    }
  }
}
