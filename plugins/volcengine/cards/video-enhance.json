{
  "apiVersion": "clash.card/v1",
  "kind": "model-card",
  "spec": {
    "id": "volcengine-mediakit-video-enhance",
    "aliases": [],
    "name": "Volcengine MediaKit Video Enhancement",
    "provider": "volcengine-mediakit",
    "kind": "video",
    "semanticShape": "video_enhancement",
    "visibility": {
      "scope": "plugin-private",
      "consumers": [
        {
          "pluginId": "clash.video-enhance",
          "definitionId": "video-enhance",
          "actionId": "enhance"
        }
      ]
    },
    "description": "Provider-managed video enhancement (upscale, reframe bitrate/fps/bit-depth) of one video Asset through Volcengine AI MediaKit.",
    "parameters": [
      {
        "id": "toolVersion",
        "label": "Tool version",
        "type": "select",
        "required": true,
        "options": [
          { "label": "Standard", "value": "standard" },
          { "label": "Professional", "value": "professional" }
        ]
      },
      {
        "id": "scene",
        "label": "Scene",
        "type": "select",
        "options": [
          { "label": "Common", "value": "common" },
          { "label": "UGC", "value": "ugc" },
          { "label": "Short series", "value": "short_series" },
          { "label": "AIGC", "value": "aigc" },
          { "label": "Old film", "value": "old_film" }
        ]
      },
      {
        "id": "enhanceStyle",
        "label": "Enhance style",
        "type": "select",
        "options": [
          { "label": "HD", "value": "hd" },
          { "label": "Natural", "value": "natural" }
        ]
      },
      {
        "id": "resolution",
        "label": "Resolution",
        "type": "select",
        "options": [
          { "label": "240p", "value": "240p" },
          { "label": "360p", "value": "360p" },
          { "label": "480p", "value": "480p" },
          { "label": "540p", "value": "540p" },
          { "label": "720p", "value": "720p" },
          { "label": "1080p", "value": "1080p" },
          { "label": "2k", "value": "2k" },
          { "label": "4k", "value": "4k" },
          { "label": "8k", "value": "8k" }
        ]
      },
      {
        "id": "resolutionLimit",
        "label": "Resolution limit",
        "type": "number",
        "min": 128,
        "max": 4320
      },
      {
        "id": "bitrateLevel",
        "label": "Bitrate level",
        "type": "select",
        "options": [
          { "label": "Low", "value": "low" },
          { "label": "Medium", "value": "medium" },
          { "label": "High", "value": "high" }
        ]
      },
      {
        "id": "bitrate",
        "label": "Bitrate",
        "type": "number",
        "min": 10,
        "max": 150000
      },
      {
        "id": "fps",
        "label": "FPS",
        "type": "number",
        "min": 15,
        "max": 120
      },
      {
        "id": "bitDepth",
        "label": "Bit depth",
        "type": "select",
        "options": [
          { "label": "8", "value": 8 },
          { "label": "10", "value": 10 },
          { "label": "12", "value": 12 },
          { "label": "16", "value": 16 }
        ]
      },
      {
        "id": "mediaOutputDestination",
        "label": "Output destination",
        "type": "text",
        "description": "Volcengine VOD (vod://<非空>) or TOS (tos://<非空>) output destination URI. The adapter rejects any other scheme or an empty path."
      },
      {
        "id": "clientToken",
        "label": "Client token",
        "type": "text"
      }
    ],
    "defaultParams": {},
    "defaultAspectRatio": "16:9",
    "input": {
      "requiresPrompt": false,
      "inputMode": {
        "videos": { "min": 1, "max": 1 },
        "maxTotalReferences": 1
      },
      "promptModalities": ["video"]
    },
    "maxRuntimeMs": 1800000
  }
}
