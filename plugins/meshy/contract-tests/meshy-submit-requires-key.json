{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "meshy-submit-requires-key",
  "description": "A submit without the selected account's API key fails before any Provider request, at the rejected boundary.",
  "target": {
    "exportId": "meshy-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "upstreamModel": "meshy-7",
      "prompt": "a monster mask"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This Meshy account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
