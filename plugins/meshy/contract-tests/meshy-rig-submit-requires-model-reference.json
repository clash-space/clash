{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "meshy-rig-submit-requires-model-reference",
  "description": "Meshy auto-rig with no attached model reference is refused before any credential is read.",
  "target": {
    "exportId": "meshy-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "upstreamModel": "rig"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "invalid_request",
      "message": "Meshy auto-rig requires exactly one model reference.",
      "retryable": false,
      "requestState": "rejected"
    }
  }
}
