{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "meshy-poll-rejects-state",
  "description": "A resumed Meshy run rejects an unusable durable poll state before reading account data.",
  "target": {
    "exportId": "meshy-execute",
    "kind": "provider-executor"
  },
  "operation": "poll",
  "pollState": {},
  "input": {
    "values": {},
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "contract_violation",
      "message": "Meshy poll state is missing or invalid.",
      "retryable": false,
      "requestState": "accepted"
    }
  }
}
