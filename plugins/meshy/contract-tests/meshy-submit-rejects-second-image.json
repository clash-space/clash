{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "meshy-submit-rejects-second-image",
  "description": "Meshy accepts at most one image reference; a second one is refused before any credential is read.",
  "target": {
    "exportId": "meshy-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "upstreamModel": "meshy-6",
      "prompt": ""
    },
    "references": [
      {
        "slot": "image",
        "index": 0,
        "asset": { "assetId": "a1", "uri": "clash-asset://a1", "kind": "image" }
      },
      {
        "slot": "image",
        "index": 1,
        "asset": { "assetId": "a2", "uri": "clash-asset://a2", "kind": "image" }
      }
    ]
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "invalid_request",
      "message": "Meshy accepts at most one image reference.",
      "retryable": false,
      "requestState": "rejected"
    }
  }
}
