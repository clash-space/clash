{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "google-execute-requires-a-host",
  "target": {
    "exportId": "google-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "model": "gemini-3.1-flash-image"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "execution_failed",
      "message": "This Google account has neither an accessToken nor an apiKey stored.",
      "retryable": false
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "accessToken"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    },
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
