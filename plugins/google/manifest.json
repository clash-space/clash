{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.google",
  "version": "0.1.0",
  "name": "Google",
  "description": "Google's generateContent surface, on both the Developer API and Agent Platform.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "google-execute",
        "kind": "provider-executor",
        "operations": [
          "submit",
          "poll"
        ]
      }
    ],
    "providers": [
      {
        "id": "google",
        "kind": "provider",
        "path": "providers/google.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/google-execute.json"
  ]
}
