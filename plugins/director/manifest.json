{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.director",
  "version": "0.1.0",
  "name": "Clash Director",
  "description": "Capture pinned Director Stage frames and retarget humanoid GLB animation.",
  "author": "Clash",
  "runtime": { "kind": "local", "transport": "stdio", "entrypoint": "dist/stdio.mjs" },
  "contributes": {
    "generators": [
      { "id": "director-stage", "kind": "generator", "path": "generators/director-stage.json" },
      { "id": "humanoid-retarget", "kind": "generator", "path": "generators/humanoid-retarget.json" }
    ],
    "functions": [
      { "id": "capture-frame", "kind": "action", "operations": ["submit"] },
      {
        "id": "retarget-humanoid",
        "kind": "action",
        "assetInputs": [
          {
            "match": { "kinds": ["model"] },
            "mediaTypes": ["model/gltf-binary"],
            "representations": ["bytes"]
          }
        ],
        "operations": ["submit"]
      }
    ],
    "hostTools": ["director.stage.capture-frame"]
  },
  "contractTests": []
}
