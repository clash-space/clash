{
  "apiVersion": "clash.generator/v1",
  "kind": "generator",
  "spec": {
    "definitionId": "humanoid-retarget",
    "stateSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "editPolicy": "advance-head",
    "persistentInputs": [],
    "actions": [{
      "id": "retarget-humanoid",
      "executorExportId": "retarget-humanoid",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "clipName": { "type": "string", "minLength": 1 },
          "rootMotion": { "type": "string", "enum": ["in-place", "preserve"] },
          "footLock": { "type": "string", "enum": ["off", "contact"] }
        },
        "required": ["clipName", "rootMotion", "footLock"],
        "additionalProperties": false
      },
      "invocationInputs": [
        {
          "slot": "target",
          "accepts": [{ "kind": "media", "mediaKind": "model" }],
          "cardinality": { "minItems": 1, "maxItems": 1 }
        },
        {
          "slot": "motion",
          "accepts": [{ "kind": "media", "mediaKind": "model" }],
          "cardinality": { "minItems": 1, "maxItems": 1 }
        }
      ],
      "outputs": [{
        "slot": "animated-model",
        "assetType": { "kind": "media", "mediaKind": "model" },
        "cardinality": { "minItems": 1, "maxItems": 1 }
      }]
    }]
  }
}
