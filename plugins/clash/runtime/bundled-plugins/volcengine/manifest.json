{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.volcengine",
  "version": "0.1.1",
  "name": "Volcengine",
  "description": "Volcengine ModelArk video and OpenSpeech audio generation.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [
      {
        "id": "volcengine-mediakit-video-enhance",
        "kind": "model-card",
        "path": "cards/video-enhance.json"
      }
    ],
    "functions": [
      {
        "id": "volcengine-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      },
      {
        "id": "volcengine-speech-execute",
        "kind": "provider-executor",
        "operations": ["submit"]
      },
      {
        "id": "volcengine-mediakit-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      }
    ],
    "providers": [
      {
        "id": "volcengine-modelark",
        "kind": "provider",
        "path": "providers/volcengine-modelark.json"
      },
      {
        "id": "volcengine-speech",
        "kind": "provider",
        "path": "providers/volcengine-speech.json"
      },
      {
        "id": "volcengine-mediakit",
        "kind": "provider",
        "path": "providers/volcengine-mediakit.json"
      }
    ],
    "modelBindings": [
      {
        "id": "volcengine-mediakit-video-enhance",
        "kind": "model-provider-binding",
        "path": "bindings/video-enhance.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/volcengine-execute.json",
    "contract-tests/volcengine-mediakit-execute.json"
  ]
}
