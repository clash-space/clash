{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "move-ai-submit-requires-key",
  "description": "A submit without the selected Move AI account's API key fails before any Provider request.",
  "target": {
    "exportId": "move-ai-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "modelId": "move-ai-s2",
      "upstreamModel": "S2"
    },
    "references": [
      {
        "slot": "video",
        "index": 0,
        "asset": {
          "assetId": "asset-1",
          "uri": "clash-asset://asset-1",
          "kind": "video",
          "mediaType": "video/mp4"
        }
      }
    ]
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This Move AI account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
