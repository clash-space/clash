{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "move-ai-poll-rejects-state",
  "description": "A resumed Move AI run rejects an unusable durable poll state before reading account data.",
  "target": {
    "exportId": "move-ai-execute",
    "kind": "provider-executor"
  },
  "operation": "poll",
  "pollState": {},
  "input": {
    "values": {
      "modelId": "move-ai-s2",
      "upstreamModel": "S2"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "contract_violation",
      "message": "Move AI poll state is missing its jobId.",
      "retryable": false,
      "requestState": "accepted"
    }
  }
}
