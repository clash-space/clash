{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.move-ai",
  "version": "0.1.0",
  "name": "Move AI",
  "description": "Move AI single-camera video-to-motion Provider binding and executor for the built-in move-ai-s2 model Card.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "move-ai-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      }
    ],
    "providers": [
      {
        "id": "move-ai",
        "kind": "provider",
        "path": "providers/move-ai.json"
      }
    ],
    "modelBindings": [
      {
        "id": "move-ai-s2",
        "kind": "model-provider-binding",
        "path": "bindings/move-ai-s2.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/move-ai-submit-requires-key.json",
    "contract-tests/move-ai-poll-rejects-state.json",
    "contract-tests/move-ai-submit-requires-video.json"
  ],
  "author": "Clash"
}
