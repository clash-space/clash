{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "tripo-submit-requires-key",
  "description": "A submit without the selected Tripo account's API key fails before any Provider request.",
  "target": {
    "exportId": "tripo-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "modelId": "tripo-h3.1",
      "upstreamModel": "v3.1-20260211",
      "prompt": "A cat wearing a spacesuit"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This Tripo account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
