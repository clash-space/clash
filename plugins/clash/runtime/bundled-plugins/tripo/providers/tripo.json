{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "tripo",
    "name": "Tripo3D",
    "description": "Tripo3D text-to-3D, image-to-3D and auto-rigging generation through the official Tripo v3 API.",
    "upstreamId": "tripo",
    "apiShape": "tripo-v3",
    "executorExportId": "tripo-execute",
    "auth": {
      "methods": [
        {
          "id": "api-key",
          "label": "API key",
          "form": [
            {
              "kind": "notice",
              "text": "Create an API Key in the Tripo Console (platform.tripo3d.ai). Clash stores it as an account secret and never exposes it to browser code."
            },
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            },
            {
              "kind": "choice",
              "key": "region",
              "label": "Region",
              "options": [
                {
                  "value": "international",
                  "label": "International (openapi.tripo3d.ai)"
                },
                {
                  "value": "china",
                  "label": "China (openapi.tripo3d.com)"
                }
              ],
              "default": "international"
            }
          ]
        }
      ]
    },
    "bindingDefaults": {
      "priority": 5,
      "assetInputs": [
        {
          "match": {
            "kinds": ["image", "model"]
          },
          "representations": ["provider-url", "bytes"]
        }
      ]
    }
  }
}
