{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "minimax",
    "name": "MiniMax",
    "upstreamId": "minimax",
    "apiShape": "minimax",
    "executorExportId": "minimax-execute",
    "auth": {
      "methods": [
        {
          "id": "api-key",
          "label": "API key",
          "form": [
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            },
            {
              "kind": "choice",
              "key": "service",
              "label": "Region",
              "options": [
                {
                  "value": "international",
                  "label": "International (api.minimax.io)"
                },
                {
                  "value": "domestic",
                  "label": "China (api.minimaxi.com)"
                }
              ],
              "default": "international"
            }
          ]
        }
      ]
    }
  }
}
