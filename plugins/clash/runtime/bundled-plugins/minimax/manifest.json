{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.minimax",
  "version": "0.1.0",
  "name": "MiniMax",
  "description": "MiniMax text, video, and audio generation on the international and domestic hosts.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "minimax-execute",
        "kind": "provider-executor",
        "operations": [
          "submit",
          "poll"
        ]
      }
    ],
    "providers": [
      {
        "id": "minimax",
        "kind": "provider",
        "path": "providers/minimax.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/minimax-execute.json",
    "contract-tests/minimax-submit-requires-key.json"
  ]
}
