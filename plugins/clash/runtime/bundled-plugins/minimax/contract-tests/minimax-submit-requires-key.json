{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "minimax-submit-requires-key",
  "description": "A submit without the selected MiniMax account's API key fails before any Provider request.",
  "target": {
    "exportId": "minimax-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "kind": "text",
      "upstreamModel": "MiniMax-M2.5",
      "prompt": "hello"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This MiniMax account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    },
    {
      "operation": {
        "kind": "store.get",
        "key": "service"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    },
    {
      "operation": {
        "kind": "store.get",
        "key": "baseUrl"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
