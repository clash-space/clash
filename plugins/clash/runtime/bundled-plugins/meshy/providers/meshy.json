{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "meshy",
    "name": "Meshy",
    "upstreamId": "meshy",
    "apiShape": "meshy",
    "executorExportId": "meshy-execute",
    "auth": {
      "methods": [
        {
          "id": "api-key",
          "label": "API key",
          "form": [
            {
              "kind": "notice",
              "text": "Create a key at meshy.ai/settings/api."
            },
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            }
          ]
        }
      ]
    }
  }
}
