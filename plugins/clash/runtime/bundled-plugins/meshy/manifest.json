{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.meshy",
  "version": "0.1.0",
  "name": "Meshy",
  "description": "Meshy text-to-3D, image-to-3D, and auto-rigging, bound to the built-in meshy-6, meshy-7, and meshy-auto-rig model cards.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "meshy-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      }
    ],
    "providers": [
      {
        "id": "meshy",
        "kind": "provider",
        "path": "providers/meshy.json"
      }
    ],
    "modelBindings": [
      {
        "id": "meshy-6",
        "kind": "model-provider-binding",
        "path": "bindings/meshy-6.json"
      },
      {
        "id": "meshy-7",
        "kind": "model-provider-binding",
        "path": "bindings/meshy-7.json"
      },
      {
        "id": "meshy-auto-rig",
        "kind": "model-provider-binding",
        "path": "bindings/meshy-auto-rig.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/meshy-submit-requires-key.json",
    "contract-tests/meshy-poll-rejects-state.json",
    "contract-tests/meshy-submit-rejects-second-image.json",
    "contract-tests/meshy-rig-submit-requires-model-reference.json"
  ]
}
