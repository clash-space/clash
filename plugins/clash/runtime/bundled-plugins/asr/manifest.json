{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.asr",
  "version": "0.1.0",
  "name": "Clash ASR",
  "description": "Create a word-aligned transcript Document from one frozen audio or video Asset.",
  "author": "Clash",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "generators": [
      {
        "id": "speech-analysis",
        "kind": "generator",
        "path": "generators/speech-analysis.json"
      }
    ],
    "functions": [
      {
        "id": "transcribe",
        "kind": "action",
        "operations": ["submit", "poll"]
      }
    ],
    "hostTools": ["speech.transcribe"]
  },
  "contractTests": ["contract-tests/transcribe.json"]
}
