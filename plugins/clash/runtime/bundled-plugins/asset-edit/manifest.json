{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.asset-edit",
  "version": "1.0.0",
  "name": "Clash Asset Edit",
  "description": "Crop, rotate, trim, or capture a frame from one immutable Project Asset.",
  "author": "Clash",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "generators": [
      {
        "id": "image-editor",
        "kind": "generator",
        "path": "generators/image-editor.json"
      },
      {
        "id": "video-clipper",
        "kind": "generator",
        "path": "generators/video-clipper.json"
      }
    ],
    "functions": [
      {
        "id": "image-editor",
        "kind": "action",
        "operations": ["submit"],
        "assetInputs": [
          {
            "match": { "slots": ["source"], "kinds": ["image"] },
            "representations": ["bytes", "executor-url"]
          }
        ]
      },
      {
        "id": "video-clipper",
        "kind": "action",
        "operations": ["submit"],
        "assetInputs": [
          {
            "match": { "slots": ["source"], "kinds": ["video"] },
            "representations": ["bytes", "executor-url"]
          }
        ]
      }
    ]
  }
}
