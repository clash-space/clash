{
  "apiVersion": "clash.generator/v1",
  "kind": "generator",
  "spec": {
    "definitionId": "video-clipper",
    "stateSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "editPolicy": "advance-head",
    "persistentInputs": [],
    "actions": [
      {
        "id": "screenshot",
        "executorExportId": "video-clipper",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "frameTimeSec": { "type": "number", "minimum": 0 }
          },
          "required": ["frameTimeSec"],
          "additionalProperties": false
        },
        "invocationInputs": [
          {
            "slot": "source",
            "accepts": [{ "kind": "media", "mediaKind": "video" }],
            "cardinality": { "minItems": 1, "maxItems": 1 }
          }
        ],
        "outputs": [
          {
            "slot": "output",
            "assetType": { "kind": "media", "mediaKind": "image" },
            "cardinality": { "minItems": 1, "maxItems": 1 }
          }
        ]
      },
      {
        "id": "crop",
        "executorExportId": "video-clipper",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "startSec": { "type": "number", "minimum": 0 },
            "endSec": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["startSec", "endSec"],
          "additionalProperties": false
        },
        "invocationInputs": [
          {
            "slot": "source",
            "accepts": [{ "kind": "media", "mediaKind": "video" }],
            "cardinality": { "minItems": 1, "maxItems": 1 }
          }
        ],
        "outputs": [
          {
            "slot": "output",
            "assetType": { "kind": "media", "mediaKind": "video" },
            "cardinality": { "minItems": 1, "maxItems": 1 }
          }
        ]
      }
    ]
  }
}
