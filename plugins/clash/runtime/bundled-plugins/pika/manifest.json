{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.pika",
  "version": "0.1.0",
  "name": "Pika API Club",
  "description": "Text, image, video, audio, and speech generation through Pika API Club.",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "functions": [
      {
        "id": "pika-execute",
        "kind": "provider-executor",
        "operations": ["submit", "poll"]
      }
    ],
    "providers": [
      {
        "id": "pika",
        "kind": "provider",
        "path": "providers/pika.json"
      }
    ]
  },
  "contractTests": [
    "contract-tests/pika-execute.json",
    "contract-tests/pika-submit-requires-key.json"
  ]
}
