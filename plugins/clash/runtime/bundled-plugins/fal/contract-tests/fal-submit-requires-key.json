{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "fal-submit-requires-key",
  "description": "A submit without the selected account's API key fails before any Provider request.",
  "target": {
    "exportId": "fal-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "kind": "model",
      "upstreamModel": "fal-ai/hunyuan3d-v3/text-to-3d",
      "prompt": "A small red robot"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "authentication_failed",
      "message": "This fal.ai account has no apiKey stored.",
      "retryable": false,
      "requestState": "rejected"
    }
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "store.get",
        "key": "apiKey"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    },
    {
      "operation": {
        "kind": "store.get",
        "key": "queueBaseUrl"
      },
      "response": {
        "status": "ok",
        "result": {}
      }
    }
  ]
}
