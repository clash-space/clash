{
  "apiVersion": "clash.plugin/v1",
  "id": "clash.video-enhance",
  "version": "0.1.0",
  "name": "Clash Video Enhance",
  "description": "Generic Generator producing one enhanced video from one frozen Project Asset, dispatched to whichever Provider implementation the Host selects.",
  "author": "Clash",
  "runtime": {
    "kind": "local",
    "transport": "stdio",
    "entrypoint": "dist/stdio.mjs"
  },
  "contributes": {
    "cards": [],
    "generators": [
      {
        "id": "video-enhance",
        "kind": "generator",
        "path": "generators/video-enhance.json"
      }
    ],
    "functions": [
      {
        "id": "enhance",
        "kind": "action",
        "operations": ["submit", "poll"]
      }
    ],
    "hostTools": ["video.enhance"]
  },
  "contractTests": []
}
