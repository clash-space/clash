{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "google-poll-rejects-state",
  "description": "A resumed Google run rejects an unusable durable poll state before reading account data.",
  "target": {
    "exportId": "google-execute",
    "kind": "provider-executor"
  },
  "operation": "poll",
  "pollState": {},
  "input": {
    "values": {
      "kind": "video",
      "upstreamModel": "veo-3.1-generate-preview"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "contract_violation",
      "message": "Google poll state is missing or invalid.",
      "retryable": false,
      "requestState": "accepted"
    }
  }
}
