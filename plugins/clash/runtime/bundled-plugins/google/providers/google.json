{
  "apiVersion": "clash.provider/v1",
  "kind": "provider",
  "spec": {
    "id": "google",
    "name": "Google",
    "upstreamId": "google-ai-studio",
    "apiShape": "google-ai-studio",
    "executorExportId": "google-execute",
    "auth": {
      "methods": [
        {
          "id": "ai-studio",
          "label": "Google AI Studio (Developer API)",
          "form": [
            {
              "kind": "notice",
              "text": "Create a key at aistudio.google.com/apikey."
            },
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            }
          ]
        },
        {
          "id": "agent-platform-key",
          "label": "Google Cloud Agent Platform (API key)",
          "form": [
            {
              "kind": "notice",
              "text": "Agent Platform accepts an API key in Express mode."
            },
            {
              "kind": "field",
              "key": "apiKey",
              "label": "API key",
              "secret": true
            },
            {
              "kind": "choice",
              "key": "region",
              "label": "Region",
              "options": [
                {
                  "value": "global",
                  "label": "Global"
                },
                {
                  "value": "us-central1",
                  "label": "us-central1"
                }
              ],
              "default": "global"
            }
          ]
        },
        {
          "id": "service-account",
          "label": "Google Cloud Agent Platform (service account)",
          "form": [
            {
              "kind": "notice",
              "text": "Paste the JSON key file. It is exchanged for an access token via RFC 7523; the assertion is signed locally and the key itself is never sent."
            },
            {
              "kind": "field",
              "key": "serviceAccountKey",
              "label": "Service account JSON",
              "secret": true
            },
            {
              "kind": "choice",
              "key": "region",
              "label": "Region",
              "options": [
                {
                  "value": "global",
                  "label": "Global"
                },
                {
                  "value": "us-central1",
                  "label": "us-central1"
                }
              ],
              "default": "global"
            }
          ]
        }
      ]
    }
  }
}
