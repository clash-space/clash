{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@clash/cli/plugin": ["../../packages/cli/src/lib/plugin-lifecycle.ts"],
      "@clash/director-plugin": ["../clash-director/src/index.ts"],
      "@clash/director-plugin/*": ["../clash-director/src/*.ts"],
      "@clash/local-api": ["../../apps/local-api/src/server.ts"],
      "@clash/action-sdk": ["../../packages/action-sdk/src/index.ts"],
      "@clash/action-sdk/browser": [
        "../../packages/action-sdk/src/browser.ts"
