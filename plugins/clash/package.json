{
  "name": "clash",
  "version": "0.1.3",
  "description": "Headless Clash distribution with CLI, stdio MCP, and the reusable local host runtime",
  "type": "module",
  "bin": {
    "clash": "./runtime/dispatcher.js"
  },
  "clashRuntime": {
    "dispatcher": "./runtime/dispatcher.js",
    "mcp": "./runtime/index.js",
    "cli": "./runtime/clash-cli.cjs",
    "localApi": "./runtime/local-api.cjs",
    "agents": "./runtime/agents"
  },
  "main": "./runtime/index.js",
  "types": "./runtime/index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/index.d.ts",
      "import": "./runtime/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "runtime",
    "skills"
  ],
  "scripts": {
    "build:host": "tsx scripts/build-host-runtime.ts",
    "build:core": "tsup && pnpm build:host && tsx scripts/copy-app-bundles.ts",
    "bundle:agents": "tsx scripts/bundle-agent-runtime.ts",
    "build": "pnpm build:core && pnpm bundle:agents",
    "clean": "rm -rf runtime",
    "dev": "CLASH_SOURCE_RUNTIME=1 tsx --tsconfig tsconfig.dev.json src/dispatcher.ts --profile dev",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.507",
    "loro-crdt": "^1.10.3",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@clash/shared-mcp": "workspace:*",
    "@clash/shared-runtime": "workspace:*",
    "@clash/cli": "workspace:*",
    "@clash/director-plugin": "workspace:*",
    "@clash/mcp-server": "workspace:*",
    "@clash/timeline-plugin": "workspace:*",
    "@clash/local-api": "workspace:*",
    "@clash/render-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remotion/bundler": "4.0.507",
    "zod": "^4.1.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "license": "MIT"
}
