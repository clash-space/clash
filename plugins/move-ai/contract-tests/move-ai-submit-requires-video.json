{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "move-ai-submit-requires-video",
  "description": "move-ai-s2 rejects a submit with no video reference before reading credentials.",
  "target": {
    "exportId": "move-ai-execute",
    "kind": "provider-executor"
  },
  "operation": "submit",
  "input": {
    "values": {
      "modelId": "move-ai-s2",
      "upstreamModel": "S2"
    },
    "references": []
  },
  "expect": {
    "status": "failed",
    "error": {
      "code": "invalid_request",
      "message": "Move AI requires exactly one reference of kind video, received 0.",
      "retryable": false,
      "requestState": "rejected"
    }
  }
}
