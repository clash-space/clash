{
  "apiVersion": "clash.plugin.contract-test/v1",
  "id": "asr-transcribe-completed",
  "description": "Returns one typed word-aligned transcript Document for the frozen source Asset.",
  "target": {
    "exportId": "transcribe",
    "kind": "action"
  },
  "context": {
    "projectId": "contract-test-project"
  },
  "input": {
    "values": {
      "modelId": "sensevoice-small-asr",
      "language": "en"
    },
    "references": [
      {
        "slot": "source",
        "index": 0,
        "asset": {
          "assetId": "contract-audio",
          "uri": "clash-asset://contract-audio",
          "kind": "audio",
          "mediaType": "audio/wav"
        }
      }
    ]
  },
  "brokerFixtures": [
    {
      "operation": {
        "kind": "speech.transcribe",
        "reference": {
          "slot": "source",
          "index": 0,
          "asset": {
            "assetId": "contract-audio",
            "uri": "clash-asset://contract-audio",
            "kind": "audio",
            "mediaType": "audio/wav"
          }
        },
        "modelId": "sensevoice-small-asr",
        "language": "en"
      },
      "response": {
        "status": "ok",
        "result": {
          "status": "completed",
          "transcript": {
            "schemaVersion": 1,
            "kind": "clash.asr.timed-transcript",
            "timebase": "milliseconds",
            "alignment": "word",
            "text": "hello",
            "backendId": "funasr",
            "modelId": "sensevoice-small-asr",
            "language": "en",
            "durationMs": 480,
            "words": [
              {
                "id": "word-1",
                "text": "hello",
                "startMs": 40,
                "endMs": 480
              }
            ],
            "segments": [
              {
                "id": "segment-1",
                "text": "hello",
                "startMs": 40,
                "endMs": 480,
                "wordIds": ["word-1"]
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "status": "completed",
    "outputs": [
      {
        "slot": "transcript",
        "kind": "document",
        "document": {
          "documentKind": "media.transcript",
          "schemaVersion": 1,
          "body": {
            "schemaVersion": 1,
            "kind": "clash.asr.timed-transcript",
            "timebase": "milliseconds",
            "alignment": "word",
            "text": "hello",
            "backendId": "funasr",
            "modelId": "sensevoice-small-asr",
            "language": "en",
            "durationMs": 480,
            "words": [
              {
                "id": "word-1",
                "text": "hello",
                "startMs": 40,
                "endMs": 480
              }
            ],
            "segments": [
              {
                "id": "segment-1",
                "text": "hello",
                "startMs": 40,
                "endMs": 480,
                "wordIds": ["word-1"]
              }
            ]
          }
        }
      }
    ]
  },
  "timeoutMs": 10000
}
